{
  "schema_version": 1,
  "description": "Explicit tool assignments for 118 real scenes. Three early white-drawer recordings have a different, uncalibrated mounting; their nominal tool transform is retained for provenance and must not be used. Unknown recordings have no default tool.",
  "reference_assumption": "Transforms are applied to the recorded Cartesian EE pose as requested. Bare contact calibration reference is assumed to coincide with that EE reference. Absolute link_6-to-tip validity requires the bare contact point to coincide with the link_6 origin; this has not been independently established.",
  "transform_convention": "T_base_tcp = T_base_recorded_ee @ T_ee_tcp; p_base_tcp = p_base_ee + R_base_ee @ t_ee_tcp",
  "table_height_shift_applied": false,
  "contact_force_convention": {
    "schema_version": 1,
    "confirmation_source": "Operator confirmation on 2026-11-13",
    "recorded_quantity": "contact_reaction_force_on_robot",
    "force_exerted_by": "object",
    "force_acting_on": "robot",
    "physical_application_point": "robot-object contact point",
    "units": "N",
    "recorded_force_fields": ["Fx_N", "Fy_N", "Fz_N", "force_N"],
    "derived_force_fields_with_same_reaction_sign": ["force_sensor_N", "force_ee_N", "force_base_N", "force_camera_N", "force_tangent_base_N", "force_perpendicular_base_N"],
    "object_side_quantity": "force_exerted_by_robot_on_object",
    "object_side_force_multiplier": -1,
    "object_side_force_equation": "F_robot_on_object_A = -F_object_on_robot_A",
    "frame_requirement": "Both forces must be expressed in the same coordinate frame A at the same contact and time; retain the existing wrench_frame axis mapping",
    "automatic_sign_reversal_applied": false,
    "existing_visualizations_show": "robot-side contact reaction, as recorded",
    "signed_tangential_force_on_object": "negative of the robot-side signed tangential force for the same trajectory tangent",
    "force_norm_and_absolute_tangential_percentage": "unchanged by action-reaction sign reversal",
    "scope": "Force-vector sign semantics only; no change to measurements, calibration, tare/gravity processing or torque origin/transport conventions"
  },
